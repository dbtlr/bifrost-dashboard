    "@types/node": "^22.20.3",
    "@types/serve-static": "^2.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "serve-static": "^2.2.1"
  },
  "license": "MIT"
}
