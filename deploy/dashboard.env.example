# Optional settings for server/service.ts. Every setting has a default; see docs/service.md.
# Changes take effect on the next `install` or `restart`.

# Loopback only: 127.x.x.x or ::1. The reverse proxy on this host reaches this listener.
BIFROST_HOST=127.0.0.1
BIFROST_PORT=4310

# /var/lib/bifrost-dashboard or /var/lib/bifrost-dashboard-NAME.
BIFROST_DATA_DIR=/var/lib/bifrost-dashboard

# The Node.js 24 binary the service runs. Defaults to the one that runs the command.
#BIFROST_NODE_BIN=/usr/bin/node
