# Absolute paths readable by the service. Keep the app and data outside /home.
BIFROST_NODE_BIN=/usr/bin/node
BIFROST_APP_DIR=/srv/bifrost-dashboard
BIFROST_BUILD_DIR=/srv/bifrost-dashboard/dist
BIFROST_DATA_DIR=/srv/bifrost-dashboard-data

# The reverse proxy on this host can reach this listener.
BIFROST_HOST=127.0.0.1
BIFROST_PORT=4310
