# Managed by bifrost-dashboard server/service.ts
# Rendered from the release's deploy/bifrost-dashboard.service; see docs/service.md there.
[Unit]
Description=Bifrost app dashboard
After=network.target

[Service]
Type=exec
WorkingDirectory=@RELEASE@
Environment=NODE_ENV=production
Environment=BIFROST_HOST=@HOST@
Environment=BIFROST_PORT=@PORT@
Environment=BIFROST_DATA_DIR=@DATA_DIR@
ExecStart=@NODE@ @RELEASE@/server/start.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
DynamicUser=yes
StateDirectory=@STATE_DIRECTORY@
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
